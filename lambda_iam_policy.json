{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3GetObject",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::your-bucket-name/*"
    },
    {
      "Sid": "RekognitionDetectLabels",
      "Effect": "Allow",
      "Action": [
        "rekognition:DetectLabels"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RekognitionDetectText",
      "Effect": "Allow",
      "Action": [
        "rekognition:DetectText"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RekognitionDetectFaces",
      "Effect": "Allow",
      "Action": [
        "rekognition:DetectFaces"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
